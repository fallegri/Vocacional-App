# ---------------------------------------------------------------------------
# OrientApp Web - Variables de entorno
# Copia este archivo a .env.local y completa los valores. NO subas .env.local.
# ---------------------------------------------------------------------------

# Cadena de conexión de Neon Postgres (serverless).
# Ejemplo: postgres://usuario:password@host.neon.tech/orientapp?sslmode=require
# La app inicializa el cliente de base de datos de forma perezosa (lazy):
# esta variable solo se lee cuando se ejecuta una consulta real, por lo que
# `next build` funciona sin definirla.
DATABASE_URL=postgres://user:pass@host.neon.tech/dbname?sslmode=require

# ---------------------------------------------------------------------------
# URL base pública de la app (opcional). Se usa para construir los enlaces de
# los códigos QR de cada grupo/cohorte y los enlaces de verificación de correo.
# (p.ej. https://tu-app.vercel.app/g/CODE o /verify?token=...).
# Si no se define, se usa el origin de la petición/navegador en QR, y
# http://localhost:3000 para los enlaces de verificación.
# NEXT_PUBLIC_APP_URL=https://tu-app.vercel.app

# ---------------------------------------------------------------------------
# Autenticación con email + contraseña (Auth.js v5 / Credentials provider)
# ---------------------------------------------------------------------------
# AUTH_SECRET es OBLIGATORIO para habilitar el inicio de sesión. Sin él, la app
# corre en "modo demo" (sin autenticación real). Genera un valor seguro con:
#   openssl rand -base64 32
# AUTH_SECRET=pon-aqui-un-secreto-largo-y-aleatorio

# ---------------------------------------------------------------------------
# Administrador inicial (opcionales). Si no se definen, se usan los valores
# por defecto documentados abajo. Ejecuta `npm run db:seed` para crear el admin.
# Contraseña por defecto: OrientApp!Admin2026
# INICIAL_ADMIN_EMAIL y INITIAL_ADMIN_PASSWORD permiten sobrescribir el correo
# y la contraseña del administrador sembrado. La contraseña NUNCA se almacena
# en texto plano: siempre se hashea con bcrypt en tiempo de ejecución.
# INITIAL_ADMIN_EMAIL=admin@orientapp.local
# INITIAL_ADMIN_PASSWORD=OrientApp!Admin2026

# ---------------------------------------------------------------------------
# Token de acceso del personal (staff). OPCIONAL y solo un FALLBACK local/demo,
# ya SUPERADO por el sistema de credenciales. Solo tiene efecto cuando la
# autenticación NO está configurada (falta AUTH_SECRET):
#   - Sin credenciales y con este token definido: TODAS las mutaciones de personal
#     (crear cohortes, firmar dictámenes) exigen presentar el token.
#   - Sin credenciales y sin este token: la app corre en "modo demo" y esas
#     operaciones quedan abiertas (útil para desarrollo/demostración).
# Cuando las credenciales SÍ están configuradas (AUTH_SECRET presente), este
# token queda INACTIVO: la autorización pasa a ser exclusivamente por sesión + rol.
# STAFF_ACCESS_TOKEN=pon-aqui-un-token-largo-y-secreto

# ---------------------------------------------------------------------------
# Envío de correos transaccionales (Resend). Configurado en FEAT-003.
# RESEND_API_KEY se usa para enviar correos de verificación y resultados.
# Sin esta variable, el envío actúa como stub (solo log en consola).
# EMAIL_FROM es el remitente del correo (por defecto: OrientApp <noreply@orientapp.local>).
# RESEND_API_KEY=re_...
# EMAIL_FROM=OrientApp <noreply@tudominio.com>
