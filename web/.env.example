# ---------------------------------------------------------------------------
# OrientApp Web - Variables de entorno
# Copia este archivo a .env.local y completa los valores. NO subas .env.local.
# ---------------------------------------------------------------------------

# Cadena de conexión de Neon Postgres (serverless).
# Ejemplo: postgres://usuario:password@host.neon.tech/orientapp?sslmode=require
# La app inicializa el cliente de base de datos de forma perezosa (lazy):
# esta variable solo se lee cuando se ejecuta una consulta real, por lo que
# `next build` funciona sin definirla.
DATABASE_URL=postgres://user:pass@host.neon.tech/dbname?sslmode=require
